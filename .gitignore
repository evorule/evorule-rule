# Rust 编译产物
/target

# SQLite 运行时产物(SQLite 库本身 vendored,不入库)
/*.db
/*.db-journal
*.db-shm
*.db-wal

# 编辑器 / IDE
*.swp
*.swo
.idea/
.vscode/
*.iml

# 本地环境配置(不提交)
.env
.env.*
!.env.example

# Data directory (runtime-generated; not tracked by default).
# Whitelist governance: everything under /data/* is ignored except the
# re-included assets below. New data directories MUST be registered as an
# exception here (silent-ignore otherwise; see O-461 precedent).
#   /data/domain_schemas/       domain JSON Schema contracts (hosted assets)
#   /data/law_sets/             hosted law-set data assets
#   /data/skeleton_sets/        hosted skeleton-set data assets (B7 hand first batch)
#   /data/migration/            migration input exports + provenance manifests (format bridge)
#   /data/candidates/           candidate-queue data assets (frozen inputs +
#                               gate outputs + deterministic pipeline manifests)
#   /data/ASSET-INVENTORY.json  asset inventory manifest
/data/*
!/data/domain_schemas
!/data/law_sets
!/data/skeleton_sets
!/data/migration
!/data/candidates
!/data/ASSET-INVENTORY.json

# OS 临时文件
.DS_Store
Thumbs.db
desktop.ini

# mdBook build output(自动生成,不进版本)
**/book/
**/docs/book/

# 内部工作临时目录
logs/
.trae/

# dev/test runtime logs
dev-test*.log

# 本地 cargo patch 覆盖(不入库,CI/发布用 crates.io 版本)
/.cargo/config.toml

# 运营登记册（本地私有面，不上库）
plan/

# 并行构建目录(本机专属,不入仓)
target-inference-s3/
